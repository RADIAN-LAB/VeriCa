# Python
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.venv/
.DS_Store

# Generated task traces. ~1 MB per seed and fully reproducible from the SUMO
# mobility trace plus the seed recorded in each result's provenance block.
experiments/multi_seed/*/tasks.csv
experiments/sensitivity/**/tasks.csv

# Precomputed invalidation oracles (regenerate with scripts/build_oracle.py)
experiments/oracle/

# Figures are regenerated by scripts/generate_intent_figures.py. Delete these
# two lines if you would rather version the exact figures a submission shipped.
experiments/figures/*.png
experiments/figures/*.pdf

# Result JSONs are deliberately NOT ignored: they are the paper's evidence and
# each one carries its own provenance block.

# LaTeX build by-products
paper/*.log
paper/*.blg
paper/*.aux
paper/*.out
paper/VeriCa_overleaf.zip
